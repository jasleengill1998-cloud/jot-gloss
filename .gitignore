.vercel
generated/
node_modules/
dist/

# Audio files (self-hosted MP3s, keep .gitkeep only)
public/audio/*.mp3

# Queue runtime files — generated by watcher.cjs, not committed.
# (Previously tracked so Perplexity could push via git; that was a prompt-
# injection vector since anything reaching staging.txt got HMAC'd into the
# agent prompt. Local-only now.)
queue/staging.txt
queue/target.txt
queue/next-task.txt
queue/next-task.sig
queue/log.txt
